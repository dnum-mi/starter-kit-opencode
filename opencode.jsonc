{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugin": [
    // "superpowers@git+https://github.com/obra/superpowers.git",
    ["./", { "groups": ["dev", "dso"] }]
  ],
  "permission": {
    "read": { "*": "allow", "**/.env.secrets": "deny", "**/.token": "deny", "**/.env": "deny" },
    "edit": { "*": "allow", "**/.env.secrets": "deny", "**/.token": "deny", "**/.env": "deny" },
    "skill": { "*": "allow" }
  }
}
